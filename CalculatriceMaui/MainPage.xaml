<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="CalculatriceMaui.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#000000">
    <ScrollView>
        <VerticalStackLayout
            Padding="16,20"
            Spacing="14">
            <HorizontalStackLayout
                HorizontalOptions="Center">
             
            </HorizontalStackLayout>
            <Border
                BackgroundColor="#1C1C1E"
                Stroke="#3A3A3C"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22"
                Padding="18"
                HeightRequest="150">

                <VerticalStackLayout
                    VerticalOptions="Center"
                    Spacing="8">
                    <Label
                        x:Name="OperationLabel"
                        Text=""
                        FontSize="20"
                        HorizontalTextAlignment="End"
                        LineBreakMode="TailTruncation"
                        TextColor="#A5A5A5" />
                    <Label
                        x:Name="DisplayLabel"
                        Text="0"
                        FontSize="48"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="End"
                        TextColor="White" />
                </VerticalStackLayout>
            </Border>
            <Grid
                RowSpacing="10"
                ColumnSpacing="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="70" />
                    <RowDefinition Height="70" />
                    <RowDefinition Height="70" />
                    <RowDefinition Height="70" />
                    <RowDefinition Height="70" />
                    <RowDefinition Height="70" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="AC"
                    FontSize="22"
                    FontAttributes="Bold"
                    BackgroundColor="#A5A5A5"
                    TextColor="Black"
                    CornerRadius="35"
                    Clicked="ClearButton_Clicked" />

                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="DEL"
                    FontSize="18"
                    FontAttributes="Bold"
                    BackgroundColor="#A5A5A5"
                    TextColor="Black"
                    CornerRadius="35"
                    Clicked="DeleteButton_Clicked" />

                <Button
                    Grid.Row="0"
                    Grid.Column="2"
                    Text="+/-"
                    FontSize="20"
                    FontAttributes="Bold"
                    BackgroundColor="#A5A5A5"
                    TextColor="Black"
                    CornerRadius="35"
                    Clicked="SignButton_Clicked" />

                <Button
                    Grid.Row="0"
                    Grid.Column="3"
                    Text="%"
                    FontSize="22"
                    FontAttributes="Bold"
                    BackgroundColor="#A5A5A5"
                    TextColor="Black"
                    CornerRadius="35"
                    Clicked="PercentButton_Clicked" />

                <Button
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="7"
                    FontSize="26"
                    BackgroundColor="#2C2C2E"
                    TextColor="White"
                    CornerRadius="35"
                    Clicked="NumberButton_Clicked" />

                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="8"
                    FontSize="26"
                    BackgroundColor="#2C2C2E"
                    TextColor="White"
                    CornerRadius="35"
                    Clicked="NumberButton_Clicked" />

                <Button
                    Grid.Row="1"
                    Grid.Column="2"
                    Text="9"
                    FontSize="26"
                    BackgroundColor="#2C2C2E"
                    TextColor="White"
                    CornerRadius="35"
                    Clicked="NumberButton_Clicked" />

                <Button
                    Grid.Row="1"
                    Grid.Column="3"
                    Text="/"
                    FontSize="28"
                    FontAttributes="Bold"
                    BackgroundColor="#FF9F0A"
                    TextColor="White"
                    CornerRadius="35"
                    Clicked="OperatorButton_Clicked" />

                <Button
                    Grid.Row="2"
                    Grid.Column="0"
                    Text="4"
                    FontSize="26"
                    BackgroundColor="#2C2C2E"
                    TextColor="White"
                    CornerRadius="35"
                    Clicked="NumberButton_Clicked" />

                <Button
                    Grid.Row="2"
                    Grid.Column="1"
                    Text="5"
                    FontSize="26"
                    BackgroundColor="#2C2C2E"
                    TextColor="White"
                    CornerRadius="35"
                    Clicked="NumberButton_Clicked" />

                <Button
                    Grid.Row="2"
                    Grid.Column="2"
                    Text="6"
                    FontSize="26"
                    BackgroundColor="#2C2C2E"
                    TextColor="White"
                    CornerRadius="35"
                    Clicked="NumberButton_Clicked" />

                <Button
                    Grid.Row="2"
                    Grid.Column="3"
                    Text="*"
                    FontSize="28"
                    FontAttributes="Bold"
                    BackgroundColor="#FF9F0A"
                    TextColor="White"
                    CornerRadius="35"
                    Clicked="OperatorButton_Clicked" />

                <Button
                    Grid.Row="3"
                    Grid.Column="0"
                    Text="1"
                    FontSize="26"
                    BackgroundColor="#2C2C2E"
                    TextColor="White"
                    CornerRadius="35"
                    Clicked="NumberButton_Clicked" />

                <Button
                    Grid.Row="3"
                    Grid.Column="1"
                    Text="2"
                    FontSize="26"
                    BackgroundColor="#2C2C2E"
                    TextColor="White"
                    CornerRadius="35"
                    Clicked="NumberButton_Clicked" />

                <Button
                    Grid.Row="3"
                    Grid.Column="2"
                    Text="3"
                    FontSize="26"
                    BackgroundColor="#2C2C2E"
                    TextColor="White"
                    CornerRadius="35"
                    Clicked="NumberButton_Clicked" />

                <Button
                    Grid.Row="3"
                    Grid.Column="3"
                    Text="−"
                    FontSize="28"
                    FontAttributes="Bold"
                    BackgroundColor="#FF9F0A"
                    TextColor="White"
                    CornerRadius="35"
                    Clicked="OperatorButton_Clicked" />

                <Button
                    Grid.Row="4"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Text="0"
                    FontSize="26"
                    BackgroundColor="#2C2C2E"
                    TextColor="White"
                    CornerRadius="35"
                    Clicked="NumberButton_Clicked" />

                <Button
                    Grid.Row="4"
                    Grid.Column="2"
                    Text="."
                    FontSize="26"
                    BackgroundColor="#2C2C2E"
                    TextColor="White"
                    CornerRadius="35"
                    Clicked="DecimalButton_Clicked" />

                <Button
                    Grid.Row="4"
                    Grid.Column="3"
                    Text="+"
                    FontSize="28"
                    FontAttributes="Bold"
                    BackgroundColor="#FF9F0A"
                    TextColor="White"
                    CornerRadius="35"
                    Clicked="OperatorButton_Clicked" />
                <Button
                    Grid.Row="5"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Text="="
                    FontSize="28"
                    FontAttributes="Bold"
                    BackgroundColor="#FF9F0A"
                    TextColor="White"
                    CornerRadius="35"
                    Clicked="EqualsButton_Clicked" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>